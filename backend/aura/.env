#Twilio API
# ─── Twilio API Credentials ──────────────────────────────────────────────────
# Get these from your Twilio Console: https://console.twilio.com/

# Your Twilio Account SID (starts with AC...)
TWILIO_ACCOUNT_SID=your_account_sid_here

# Your Twilio Auth Token (or API Key Secret)
