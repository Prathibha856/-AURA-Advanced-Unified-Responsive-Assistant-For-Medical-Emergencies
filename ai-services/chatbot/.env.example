# AURA Medical RAG Chatbot Configuration

# LLM Provider (Ollama)
OLLAMA_URL=http://localhost:11434/api/generate
LLM_MODEL=gemma:2b
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_TOP_K=40
LLM_MAX_TOKENS=512
LLM_TIMEOUT=120
LLM_CONTEXT_WINDOW=4096

# Embedding Model (Hugging Face)
EMBEDDING_MODEL_NAME=microsoft/BiomedNLP-PubMedBERT-base-uncased-abstract
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=medical_knowledge
KNOWLEDGE_BASE_JSON=./knowledge_base/medical_qa.json

# Hybrid Retrieval Settings
DENSE_TOP_K=25
BM25_TOP_K=25
FUSED_CANDIDATES=40
RRF_K=60

# Reranker Model
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=6
USE_RERANKER=true

# Verification & Safety
ENABLE_VERIFIER=true
MAX_REGENERATION_ATTEMPTS=2

# Observability & Debug Mode
RAG_DEBUG=false
