# ============================================
# AURA ai-services — module-specific ignores
# ============================================

# Data (too big)
datasets/
modules/*/data/
*.csv
*.xlsx
*.arff
*.zip

# Trained models (regenerable)
models/*.pkl
modules/*/models/*.pkl

# Evaluation outputs (regenerable)
evaluation/
modules/*/reports/

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
